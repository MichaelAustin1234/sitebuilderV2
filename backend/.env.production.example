# --- PRODUCTION ENVIRONMENT VARIABLES (RAILWAY / RENDER / PLANETSCALE) ---

APP_NAME="UMKM Sitebuilder API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://nama-backend-anda.up.railway.app

# FRONTEND URL (Domain Vercel Frontend Anda)
FRONTEND_URL=https://nama-frontend-anda.vercel.app

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=info

# DATABASE CONFIGURATION (DIISI SESUAI MYSQL RAILWAY/PLANETSCALE)
DB_CONNECTION=mysql
DB_HOST=containers-us-west-xxx.railway.app
DB_PORT=3306
DB_DATABASE=railway
DB_USERNAME=root
DB_PASSWORD=xxxxxxxxxxxx

# SANCTUM & SESSION
SESSION_DRIVER=database
SESSION_LIFETIME=120
SANCTUM_STATEFUL_DOMAINS=nama-frontend-anda.vercel.app

# STORAGE DISK
FILESYSTEM_DISK=public
